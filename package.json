{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:dev": "NODE_OPTIONS=--max-old-space-size=8192 vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "baseline:check-deps": "node scripts/check-playwright-deps.mjs",
    "baseline:update": "bun run baseline:check-deps && playwright install --with-deps chromium && playwright test --update-snapshots",
    "baseline:verify": "bun run baseline:check-deps && playwright install --with-deps chromium && playwright test --fail-on-flaky-tests",
    "baseline:update:clean": "bun run baseline:check-deps && rm -rf tests/visual/centering.spec.ts-snapshots/ && playwright uninstall --all && playwright install --with-deps chromium && playwright test --update-snapshots",
    "baseline:ci": "bun run baseline:check-deps && playwright install --with-deps chromium && playwright test --update-snapshots=missing",
    "test:e2e": "playwright test --config=playwright.e2e.config.ts",
    "test:e2e:admin": "playwright test --config=playwright.e2e.config.ts tests/e2e/admin-smoke.spec.ts tests/e2e/admin-lists.spec.ts"
  },
